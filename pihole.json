{
  "builders": [
    {
      "type": "lxd",
      "name": "pihole",
      "init_sleep": "5",
      "image": "resolute-base",
      "output_image": "pihole",
      "publish_properties": {
        "description": "pihole dns blocking"
      }
    }
  ],
  "provisioners":[
      {
          "type": "shell",
          "script": "scripts/unbound.sh"
      },
      {
          "type": "file",
          "source": "files/etc/unbound/unbound.conf.d/pi-hole.conf",
          "destination": "/etc/unbound/unbound.conf.d/pi-hole.conf"
      },
      {
          "type": "shell",
          "inline": ["chown root:root /etc/unbound/unbound.conf.d/pi-hole.conf && chmod 0644 /etc/unbound/unbound.conf.d/pi-hole.conf"]
      },
      {
          "type": "shell",
          "inline": ["mkdir /etc/pihole/"]
      },
      {
          "type": "file",
          "source": "files/etc/pihole/setupVars.conf",
          "destination": "/etc/pihole/setupVars.conf"
      },
      {
          "type": "shell",
          "inline": ["wget -O basic-install.sh https://install.pi-hole.net; sudo PIHOLE_SKIP_OS_CHECK=true bash ./basic-install.sh --unattended || true"]
      },
      {
          "type": "file",
          "source": "files/etc/pihole/adlists.list",
          "destination": "/etc/pihole/adlists.list"
      }
  ]
}
